// MARK: - Product

APP_BUNDLE_ID_PREFIX = com.kamilgomolka

// MARK: - Code Signing

CODE_SIGN_STYLE = Automatic

// MARK: - Platform

SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1

// MARK: - Swift

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_STRICT_MEMORY_SAFETY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES

// MARK: - Local Overrides

// DEVELOPMENT_TEAM is intentionally absent from version control so a clone builds
// on the Simulator without signing changes. See Config/Local.xcconfig.example.
#include? "../Local.xcconfig"
